{
  "expo": {
    "name": "PheleCheck",
    "slug": "phelecheck",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "phelecheck",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phelecheck.app",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.phelecheck.app",
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PheleCheck to access screenshots you choose for fraud-risk analysis.",
          "cameraPermission": "Allow PheleCheck to use the camera for scanning suspicious content."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PheleCheck to use the camera for QR and fraud-risk checks.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
